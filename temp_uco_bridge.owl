  <rdf:Description rdf:about="http://ffrdc.ebiquity.umbc.edu/ns/ontology/email">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>Email or electronic mail is the method of sending messages from a computer or mobile device from one user to one or more users via the Internet. Emails travel across different time zones within a snap of a finger and hence are considered an effective mode of communication for both personal and professional purposes.

Source: https://www.zoho.com/mail/glossary/what-is-email.html</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://ffrdc.ebiquity.umbc.edu/ns/ontology/Account"/>
  </rdf:Description>
