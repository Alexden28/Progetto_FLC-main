    ns1:hasCampaign ns1:Texas ;
    ns1:hasCountry "United States of America"^^xsd:string ;
    ns1:hasCounty "Harris"^^xsd:string ;
    ns1:hasEventDate "2025-08-12T00:00:00"^^xsd:dateTime ;
