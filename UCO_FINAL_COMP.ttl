ns2:OperatingSystem a owl:Class ;
    rdfs:comment "Formal definition for OperatingSystem within the cybersecurity domain."^^xsd:string ;
    rdfs:seeAlso "http://dbpedia.org/ontology/operatingSystem"^^xsd:anyURI ;
    rdfs:subClassOf ns2:Software .

ns2:hasIPAddress a owl:ObjectProperty ;
    rdfs:domain ns2:System ;
    rdfs:range ns2:IPAddress ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf ns1:isIPAddress_of .

ns2:hasMeans a owl:ObjectProperty ;
    rdfs:domain ns2:Attack,
        ns2:Campaign,
        ns2:Vulnerability,
        ns1:Indicator ;
    rdfs:range ns2:Means ;
    owl:inverseOf ns1:isMeans_of .

