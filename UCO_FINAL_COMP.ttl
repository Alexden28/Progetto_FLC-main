ns1:a00deb440367fae0 a ns1:AgencyAttack,
        owl:NamedIndividual ;
    ns2:associatedCampaigns ns1:Trimble ;
    ns2:description "Industrial-Espionage"^^xsd:string ;
    ns2:isLaunchedBy ns1:China ;
    ns1:behaviour ns1:Industrial_Espionage ;
    ns1:hasActor "Ministry of State Security's (MSS) Guangdong State Security Department (GSSD) (APT3)"^^xsd:string ;
    ns1:hasActorCountry "China"^^xsd:string ;
    ns1:hasActorType "Nation-State"^^xsd:string ;
    ns1:hasCampaign ns1:California ;
    ns1:hasCountry "United States of America"^^xsd:string ;
    ns1:hasCounty "Santa Clara"^^xsd:string ;
    ns1:hasEventDate "2017-11-27T00:00:00"^^xsd:dateTime ;
    ns1:hasEventSubtype "Exploitation of Application Server"^^xsd:string ;
    ns1:hasEventType "Exploitive"^^xsd:string ;
    ns1:hasMonth 11 ;
    ns1:hasOrganization "Trimble"^^xsd:string ;
    ns1:hasState "California"^^xsd:string ;
    ns1:hasYear 2017 ;
    ns1:isType_of ns1:Exploitation_of_Application_Server,
        ns1:Nation_State ;
    rdfs:comment "The U.S. Department of Justice indicted three members of Boyusec, a China-based internet security firm, on charges including conspiring to commit computer fraud and abuse and conspiring to commit trade-secret theft. The victims included Moody's Analytics, Siemens, and Trimble. Though not mentioned in the indictment, Boyusec is believed to work on behalf of China's Ministry of State Security and be a front for APT3."^^xsd:string .

