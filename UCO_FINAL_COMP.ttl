ns1:hasAffectedSoftware a owl:ObjectProperty ;
    rdfs:comment "The Affected_Software field captures the list of platforms and software that are affected by this vulnerability. It is implemented through the CybOX Observables, the suggested CybOX objects to use are the Product Object, the Device Object, the System Object, and the Code Object."^^xsd:string ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing ;
    rdfs:seeAlso "http://stixproject.github.io/data-model/1.2/et/VulnerabilityType/"^^xsd:string ;
    owl:equivalentProperty ns1:hasObservable ;
    owl:inverseOf ns1:isAffectedSoftware_of .

ns1:hasAssociatedCampaign a owl:ObjectProperty ;
    rdfs:domain ns2:Attacker,
        ns2:Campaign ;
    rdfs:range ns2:Campaign ;
    owl:inverseOf ns1:isAssociatedCampaign_of .

ns1:hasAttacker a owl:ObjectProperty ;
    rdfs:domain ns2:Attack ;
    rdfs:range ns2:Attacker ;
    rdfs:subPropertyOf ns2:hasMeans ;
    owl:inverseOf ns1:isAttacker_of .

ns1:hasCOAType a owl:ObjectProperty ;
    rdfs:domain ns2:CourseofAction ;
    rdfs:range owl:Thing ;
    owl:inverseOf ns1:isCOAType_of .

ns1:hasCVE_ID a owl:ObjectProperty ;
    rdfs:domain ns2:Vulnerability ;
    rdfs:range ns1:CVE ;
    owl:inverseOf ns1:isCVE_ID_of .

ns1:hasCVSSScore a owl:ObjectProperty ;
    rdfs:domain ns2:Vulnerability ;
    rdfs:range ns1:CVSSScoreType ;
    owl:inverseOf ns1:isCVSSScore_of .

ns1:hasCampaign a owl:ObjectProperty ;
    rdfs:domain ns1:Indicator ;
    rdfs:range ns2:Campaign ;
    owl:inverseOf ns1:isCampaign_of .

ns1:hasConfidenceValue a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:domain ns2:Attack,
        ns2:Attacker,
        ns2:Campaign,
        ns1:Indicator,
        ns1:StatementType ;
    rdfs:range ns1:ConfidenceType,
        xsd:float ;
    owl:inverseOf ns1:isConfidenceValue_of .

ns1:hasConfiguration a owl:ObjectProperty ;
    rdfs:domain ns2:ExploitTarget ;
    rdfs:range ns1:CCE ;
    owl:inverseOf ns1:isConfiguration_of .

ns1:hasCost a owl:ObjectProperty ;
    rdfs:domain ns2:CourseofAction ;
    rdfs:range ns1:StatementType ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf ns1:isCost_of .

ns1:hasEfficacy a owl:ObjectProperty ;
    rdfs:domain ns2:CourseofAction ;
    rdfs:range ns1:StatementType ;
    owl:inverseOf ns1:isEfficacy_of .

ns1:hasImpact a owl:ObjectProperty ;
    rdfs:domain ns2:CourseofAction,
        ns1:Indicator ;
    rdfs:range ns1:StatementType ;
    owl:inverseOf ns1:isImpact_of .

ns1:hasIncident a owl:ObjectProperty ;
    rdfs:domain ns2:Campaign ;
    rdfs:range ns2:Incident ;
    owl:inverseOf ns1:isIncident_of .

ns1:hasIndicator a owl:ObjectProperty ;
    rdfs:domain ns2:Attack,
        ns2:Campaign ;
    rdfs:range ns1:Indicator ;
    owl:inverseOf ns1:isIndicator_of .

ns1:hasIntendedEffect a owl:ObjectProperty ;
    rdfs:domain ns2:Attacker,
        ns2:Campaign,
        ns2:Means ;
    rdfs:range ns1:StatementType ;
    owl:inverseOf ns1:isIntendedEffect_of .

ns1:hasKernel a owl:ObjectProperty ;
    rdfs:domain ns2:OperatingSystem ;
    rdfs:range ns2:KernelModule ;
    owl:inverseOf ns1:isKernel_of .

ns1:hasKillChain a owl:ObjectProperty ;
    rdfs:domain ns2:Means ;
    rdfs:range <http://stix.mitre.org/STIX#KillChain> ;
    owl:inverseOf ns1:isKillChain_of .

ns1:hasKillChainPhase a owl:ObjectProperty ;
    rdfs:domain ns2:Means,
        ns1:Indicator ;
    rdfs:range ns1:KillChainPhase ;
    owl:inverseOf ns1:isKillChainPise_of .

ns1:hasMotivation a owl:ObjectProperty ;
    rdfs:domain ns2:Attacker ;
    rdfs:range ns1:StatementType ;
    owl:inverseOf ns1:isMotivation_of .

ns1:hasOSVDB a owl:ObjectProperty ;
    rdfs:domain ns2:Vulnerability ;
    rdfs:range ns1:OSVDB ;
    owl:inverseOf ns1:isOSVDB_of .

ns1:hasObservedMeans a owl:ObjectProperty ;
    rdfs:domain ns2:Attacker ;
    rdfs:range ns2:Means ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf ns1:isObservedMeans_of .

ns1:hasParameterObservables a owl:ObjectProperty ;
    rdfs:domain ns2:CourseofAction ;
    rdfs:range ns2:Consequence ;
    owl:inverseOf ns1:isParameterObservables_of .

ns1:hasRelatedCOA a owl:ObjectProperty ;
    rdfs:domain ns2:CourseofAction ;
    rdfs:range ns2:CourseofAction ;
    owl:inverseOf ns1:isRelatedCOA_of .

ns1:hasRelatedIncident a owl:ObjectProperty ;
    rdfs:domain ns2:Attacker ;
    rdfs:range ns2:Incident ;
    owl:inverseOf ns1:isRelatedIncident_of .

ns1:hasRelatedIndicator a owl:ObjectProperty ;
    rdfs:domain ns1:Indicator ;
    rdfs:range ns1:Indicator ;
    owl:inverseOf ns1:isRelatedIndicator_of .

ns1:hasRelatedMeans a owl:ObjectProperty ;
    rdfs:domain ns2:Means ;
    rdfs:range ns2:Means ;
    owl:inverseOf ns1:isRelatedMeans_of .

ns1:hasRequestedCOA a owl:ObjectProperty ;
    rdfs:domain ns2:Attack ;
    rdfs:range ns2:CourseofAction ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf ns1:isRequestedCOA_of .

ns1:hasSoftware a owl:ObjectProperty ;
    rdfs:domain ns2:Observable ;
    rdfs:range ns2:Software ;
    owl:inverseOf ns1:isSoftware_of .

ns1:hasSophistication a owl:ObjectProperty ;
    rdfs:domain ns2:Attacker ;
    rdfs:range ns1:StatementType ;
    owl:inverseOf ns1:isSophistication_of .

ns1:hasStage a owl:ObjectProperty ;
    rdfs:comment "hasStage is used to denote stage/phase of a particular course of action represented as nominals"^^xsd:string ;
    rdfs:domain ns2:CourseofAction ;
    rdfs:range [ a owl:Class ;
            owl:oneOf ( ns1:Remedy ns1:Response ) ] ;
    owl:inverseOf ns1:isStage_of .

ns1:hasStatus a owl:ObjectProperty ;
    rdfs:domain ns2:Campaign ;
    rdfs:range owl:Thing ;
    owl:inverseOf ns1:isStatus_of .

ns1:hasSuggestedCOA a owl:ObjectProperty ;
    rdfs:domain ns1:Indicator ;
    rdfs:range ns2:CourseofAction ;
    owl:inverseOf ns1:isSuggestedCOA_of .

ns1:hasTakenCOA a owl:ObjectProperty ;
    rdfs:domain ns2:Attack ;
    rdfs:range ns2:CourseofAction ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf ns1:isTakenCOA_of .

ns1:hasType a owl:ObjectProperty ;
    rdfs:domain ns2:Attacker ;
    rdfs:range ns1:StatementType ;
    owl:inverseOf ns1:isType_of .

ns1:hasWeakness a owl:ObjectProperty ;
    rdfs:domain ns2:ExploitTarget ;
    rdfs:range ns2:CWE ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf ns1:isWeakness_of .

