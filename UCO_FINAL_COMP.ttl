<http://stix.mitre.org/STIX#KillChainPhase> a owl:Class ;
    rdfs:comment "Formal definition for KillChainPhase within the cybersecurity domain."^^xsd:string ;
    rdfs:subClassOf ns2:UCOThing .

ns2:DirectoryExposure a owl:Class ;
    rdfs:comment "Formal definition for DirectoryExposure within the cybersecurity domain."^^xsd:string ;
    rdfs:subClassOf ns2:LossOfConf .

ns2:ExICMPEchoReq a owl:Class ;
    rdfs:comment "Formal definition for ExICMPEchoReq within the cybersecurity domain."^^xsd:string ;
    rdfs:subClassOf ns2:Means .

ns2:InputValidationError a owl:Class ;
    rdfs:comment "Formal definition for InputValidationError within the cybersecurity domain."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns2:resultsIn ;
            owl:someValuesFrom ns2:LossOfConf ],
        ns2:Means .

ns2:MeansOrConsequence a owl:Class ;
    rdfs:comment "Formal definition for MeansOrConsequence within the cybersecurity domain."^^xsd:string ;
    rdfs:subClassOf ns2:UCOThing .

ns2:NetFlood a owl:Class ;
    rdfs:comment "Formal definition for NetFlood within the cybersecurity domain."^^xsd:string ;
    rdfs:seeAlso "http://dbpedia.org/describe/?url=http%3A%2F%2Fsw.opencyc.org%2F2008%2F06%2F10%2Fconcept%2Fen%2FTribeFloodNet_DenialOfServiceProgram&sid=7707"^^xsd:anyURI ;
    rdfs:subClassOf ns2:DenialOfService .

ns2:OtherTechnicalTerms a owl:Class ;
    rdfs:comment "Formal definition for OtherTechnicalTerms within the cybersecurity domain."^^xsd:string ;
    rdfs:subClassOf ns2:UCOThing .

ns2:PingScan a owl:Class ;
    rdfs:comment "Formal definition for PingScan within the cybersecurity domain."^^xsd:string ;
    rdfs:subClassOf ns2:Probe .

ns2:SelfPropagatingCode a owl:Class ;
    rdfs:comment "Formal definition for SelfPropagatingCode within the cybersecurity domain."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns2:resultsIn ;
            owl:someValuesFrom ns2:LossOfConf ],
        ns2:MaliciousCodeExecution .

ns2:TCPPortScan a owl:Class ;
    rdfs:comment "Formal definition for TCPPortScan within the cybersecurity domain."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns2:resultsIn ;
            owl:someValuesFrom ns2:DirectoryExposure ],
        ns2:Probe .

ns2:TriggeredCode a owl:Class ;
    rdfs:comment "Formal definition for TriggeredCode within the cybersecurity domain."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns2:resultsIn ;
            owl:someValuesFrom ns2:LossOfIntegrity ],
        [ a owl:Restriction ;
            owl:onProperty ns2:resultsIn ;
            owl:someValuesFrom ns2:LossOfConf ],
        ns2:MaliciousCodeExecution .

ns2:Worm a owl:Class ;
    rdfs:comment "Formal definition for Worm within the cybersecurity domain."^^xsd:string ;
    rdfs:seeAlso "http://dbpedia.org/resource/Computer_worm"^^xsd:anyURI ;
    rdfs:subClassOf ns2:SelfPropagatingCode .

ns2:hasConsequence a owl:ObjectProperty ;
    rdfs:domain ns2:Vulnerability ;
    rdfs:range ns2:Consequence ;
    owl:inverseOf ns1:isConsequence_of .

ns2:rstProbe a owl:Class ;
    rdfs:comment "Formal definition for rstProbe within the cybersecurity domain."^^xsd:string ;
    rdfs:subClassOf ns2:Probe .

ns2:usesAttacks a owl:ObjectProperty ;
    rdfs:domain ns2:Campaign ;
    rdfs:range ns2:Attack ;
    owl:inverseOf ns1:is_usesAttacks_of .

