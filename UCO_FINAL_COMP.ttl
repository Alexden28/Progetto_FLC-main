    ns1:behaviour ns1:Political_Espionage ;
    ns1:hasActorType "Criminal"^^xsd:string ;
    ns1:hasCountry "Belarus"^^xsd:string ;
    ns1:hasEventDate "2017-09-28T00:00:00"^^xsd:dateTime ;
    ns1:hasEventSubtype "Exploitation of End Hosts"^^xsd:string ;
    ns1:hasEventType "Exploitive"^^xsd:string ;
    ns1:hasIndustry "Public Administration"^^xsd:string ;
