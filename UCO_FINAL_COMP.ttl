ns1:DataBreach a owl:Class ;
    rdfs:label "data breach"^^xsd:string ;
    rdfs:comment """A data breach is any security incident in which unauthorized parties access sensitive or confidential information, including personal data (Social Security numbers, bank account numbers, healthcare data) and corporate data (customer records, intellectual property, financial information).

Source: https://www.ibm.com/think/topics/data-breach"""^^xsd:string ;
    rdfs:subClassOf ns2:Consequence ;
    owl:equivalentClass ns1:DataLeak .

