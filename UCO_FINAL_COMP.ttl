ns2:Hardware a owl:Class ;
    rdfs:comment "Formal definition for Hardware within the cybersecurity domain."^^xsd:string ;
    rdfs:seeAlso "http://dbpedia.org/resource/Computer_hardware"^^xsd:anyURI ;
    rdfs:subClassOf ns2:UCOThing .

ns2:KernelModule a owl:Class ;
    rdfs:comment "Formal definition for KernelModule within the cybersecurity domain."^^xsd:string ;
    rdfs:seeAlso "http://dbpedia.org/resource/Loadable_kernel_module"^^xsd:anyURI ;
