ns1:88aea23a274bf723 a ns1:CyberattackInformation,
        owl:NamedIndividual ;
    ns2:description "Political-Espionage"^^xsd:string ;
    ns1:behaviour ns1:Political_Espionage ;
    ns1:hasActorType "Criminal"^^xsd:string ;
    ns1:hasCountry "Ukraine"^^xsd:string ;
    ns1:hasEventDate "2022-02-23T00:00:00"^^xsd:dateTime ;
    ns1:hasEventSubtype "Exploitation of Application Server"^^xsd:string ;
    ns1:hasEventType "Mixed"^^xsd:string ;
