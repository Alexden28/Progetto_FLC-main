    ns1:hasEventSubtype "Exploitation of Network Infrastructure"^^xsd:string ;
    ns1:hasEventType "Exploitive"^^xsd:string ;
    ns1:hasIndustry "Finance and Insurance"^^xsd:string ;
    ns1:hasMonth 8 ;
