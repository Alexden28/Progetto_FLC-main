ns1:u5s1c2o3f4t5w6r7 a ns1:CyberattackData,
        owl:NamedIndividual ;
    ns2:associatedCampaigns ns1:U_S__federal_judiciary_CM_ECF___PACER_sy ;
    ns2:description "Political-Espionage"^^xsd:string ;
    ns2:isLaunchedBy ns1:Russian_Federation ;
    ns1:behaviour ns1:Political_Espionage ;
    ns1:hasActorCountry "Russian Federation"^^xsd:string ;
    ns1:hasActorType "Nation-State"^^xsd:string ;
    ns1:hasCountry "United States of America"^^xsd:string ;
    ns1:hasEventDate "2025-07-04T00:00:00"^^xsd:dateTime ;
    ns1:hasEventSubtype "Exploitation of Application Server"^^xsd:string ;
    ns1:hasEventType "Exploitive"^^xsd:string ;
    ns1:hasIndustry "Public Administration"^^xsd:string ;
